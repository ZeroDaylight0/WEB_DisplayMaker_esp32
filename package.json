{
  "name": "pixelforge-display-editor",
  "private": true,
  "version": "1.1.0",
  "description": "Visual display editor and code generator for ESP32/Arduino and ESPHome",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZeroDaylight0/WEB_DisplayMaker_esp32.git"
  },
  "keywords": [
    "esp32",
    "arduino",
    "esphome",
    "display",
    "oled",
    "tft",
    "u8g2",
    "arduino-gfx",
    "editor"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "node server.mjs",
    "start": "node server.mjs",
    "build": "node ./node_modules/typescript/bin/tsc && node ./node_modules/vite/bin/vite.js build",
    "test": "vitest run",
    "test:server": "node --test server-tests.mjs",
    "preview": "vite preview",
    "check": "npm run build && npm test && npm run test:server"
  },
  "dependencies": {
    "lucide-react": "^1.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "typescript": "5.8.3",
    "vite": "6.4.5",
    "vitest": "4.1.12"
  }
}
