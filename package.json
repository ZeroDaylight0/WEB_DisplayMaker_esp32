{
  "name": "pixelforge-display-editor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "node server.mjs",
    "start": "node server.mjs",
