    "vite": "^8.3.0",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "lucide-react": "^1.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "description": "Visual editor and code generator for microcontroller displays"
